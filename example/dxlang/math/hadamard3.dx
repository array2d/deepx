# hadamard3: 三元 Hadamard 积 a * b * c
# mul 是 binary GPU op，分两步完成
def hadamard3() -> ("/data/result") {
    newtensor("f32", "[128]") -> "/data/a"
    newtensor("f32", "[128]") -> "/data/b"
    newtensor("f32", "[128]") -> "/data/c"
    newtensor("f32", "[128]") -> "/data/temp"
    newtensor("f32", "[128]") -> "/data/result"

    # temp = a * b
    mul("/data/a", "/data/b") -> "/data/temp"
    # result = temp * c
    mul("/data/temp", "/data/c") -> "/data/result"

    deltensor("/data/a")
    deltensor("/data/b")
    deltensor("/data/c")
    deltensor("/data/temp")
}
